{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "preserve",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "unplugin-icons/types/vue"],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": ["src/**/*", "src/**/*.vue", "*.config.ts"],
    "exclude": ["node_modules", "dist"]
}
